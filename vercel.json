{
    "cleanUrls": true,
    "buildCommand": "cd client && npm ci --legacy-peer-deps && npm run build",
    "outputDirectory": "client/dist",
    "framework": "vite",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "resumecraft-beta-blush.vercel.app"
                }
            ],
            "destination": "https://resumecraft.co.in/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.resumecraft.co.in"
                }
            ],
            "destination": "https://resumecraft.co.in/$1",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://images.unsplash.com https://*.unsplash.com https://resumecraft.co.in; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://accounts.google.com https://fonts.googleapis.com https://fonts.gstatic.com https://www.google-analytics.com https://region1.google-analytics.com https://resumecraft.co.in; frame-src https://accounts.google.com;"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "resumecraft-beta-blush.vercel.app"
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/editor",
            "destination": "/index.html"
        },
        {
            "source": "/editor/:id*",
            "destination": "/index.html"
        },
        {
            "source": "/google4d740df52294f260.html",
            "destination": "/google4d740df52294f260.html"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap.xml"
        },
        {
            "source": "/((?!api/|templates|cover-letter-templates|resume-builder-dashboard|ats-resume-checker-preview|free-resume-templates|resume-template|about|contact|terms|privacy|cookies|blog|resource|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}